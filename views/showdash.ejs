<% layout("/layouts/boilerplate.ejs") %>
  
<!-- <h3>Welcome <%= user.username %></h3> -->
<h2>Your Skills:</h2>

<% if (user.skills && user.skills.length > 0) { %>
  <% let skill = user.skills[user.skills.length - 1]; %>
  <div>
    <strong>Username</strong> <%= skill.username%><br>
    <strong>Location:</strong> <%= skill.location %><br>
    <strong>Profile Photo:</strong> <%= skill.profilePhoto %><br>
    <strong>Skills Offered:</strong> <%= skill.skillsOffered %><br>
    <strong>Skills Wanted:</strong> <%= skill.skillsWanted %><br>
    <strong>Availability:</strong> <%= skill.availability %><br>
  </div>
<% } else { %>
  <p>No skill added yet.</p>
<% } %>

