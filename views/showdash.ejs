<% layout("/layouts/boilerplate.ejs") %>

<h2>Your Skills</h2>

<% if (user.skills && user.skills.length > 0) { %>
  <% const skill = user.skills[user.skills.length - 1]; %>

  <strong>Username:</strong> <%= skill.username %><br>
  <strong>Location:</strong> <%= skill.location %><br>

  <% if (skill.profilePhoto) { %>
    <img src="/<%= skill.profilePhoto %>" width="150">
  <% } %>

  <br>

  <strong>Skills Offered:</strong>
  <%= skill.skillsOffered? skill.skillsOffered : "Not added" %>
  <br>

  <strong>Skills Wanted:</strong>
  <%= skill.skillsWanted ? skill.skillsWanted : "Not added" %>
  <br>

  <strong>Availability:</strong>
  <%= skill.availability %>

<% } else { %>
  <p>No skills added yet.</p>
<% } %>
