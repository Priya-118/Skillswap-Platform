<% layout("/layouts/boilerplate.ejs") %>

<!-- individual user detail  -->

<div class="container mt-5">
<div class="row">

  <!-- <div class="col-6 offset-2 mb-3">
    <h3 class="fw-bold"></h3>
  </div> -->

  <div class="card col-8 offset-2 shadow-lg p-3 mb-4 bg-white rounded">
    
    <div class="text-center mt-3">
    <% if(user.skills[0]?.profilePhoto) { %>
        <img src="<%=user.skills[0].profilePhoto %>" alt="<%=user.username %>" class="img-fluid rounded-circle" width="200">
      <% } else { %>
        <img src="/default-profile.png" alt="default" class="img-fluid rounded-circle" width="150">
      <% } %>
    </div>

    <div class="card-body text-center">
      <p class="card-text fs-5">
      <b><%=user.username %></b> 
      <br>
      <span class="">Email:</span> <%=user.email %>
    </p>

  <!-- Skill Details -->
  <% if (user.skills.length > 0) { %>

<p><strong>Location:</strong> <%= user.skills[0].availability %></p>
<p><strong>Availability:</strong> <%= user.skills[0].availability %></p>

<div class="row mt-3">

  <!-- Skills Offered -->
  <div class="col-md-6">
    <h5>Skills Offered</h5>
    <ul class="list-group mb-3">
      <% for (let skill of user.skills) { %>
        <li class="list-group-item"><%= skill.skillsOffered.join(", ") %></li>
      <% } %>
    </ul>
  </div>

  <!-- Skills Wanted -->
  <div class="col-md-6">
    <h5>Skills Wanted</h5>
    <ul class="list-group mb-3">
      <% for (let skill of user.skills) { %>
        <li class="list-group-item"><%= skill.skillsWanted.join(", ") %></li>
      <% } %>
    </ul>
  </div>

</div>

<% } else { %>
<p class="text-muted">No skills added yet.</p>
<% } %>

</div>  
</div>

<div class="review col-8 offset-2 text-center mb-4">
  <button class="btn btn-primary">
    <a href="/users/<%=user._id%>/request" class="text-white text-decoration-none">
      Make Request
    </a>
  </button>
</div>

<div class="col-8 offset-2">
<p>
<a href="/users" class="btn btn-outline-secondary mb-4">⬅ Back to All Users</a>
</p>

<h4 class="mb-3">Add Review</h4>

<form method="post" action="/users/<%=user._id%>/review" class="card p-3 shadow-sm">

<label class="form-label">Comment:</label>
<input id="comment" name="comment" type="text" class="form-control mb-3">

<!-- Star Rating -->
<div class="mb-3 mt-3 text-warning fs-4">

<input type="radio" id="star5" name="rating" value="5" required />
<label for="star5">★</label>

<input type="radio" id="star4" name="rating" value="4" />
<label for="star4">★</label>

<input type="radio" id="star3" name="rating" value="3" />
<label for="star3">★</label>

<input type="radio" id="star2" name="rating" value="2" />
<label for="star2">★</label>

<input type="radio" id="star1" name="rating" value="1" />
<label for="star1">★</label>

</div>

<button class="btn btn-success">Submit</button>

</form>

<hr class="my-4">

<h4 class="mb-3">All Reviews</h4>

<% if (skills.length > 0 && skills[0].review) { %>

  <% for(let review of skills[0].review) { %>

    <div class="card mb-3 shadow-sm">
      <div class="card-body">

      <h6 class="text-muted"><%= review.createdAt.toLocaleString() %></h6>

      <h5 class="card-title"><%= review.reviewer.username %></h5>

      <p><%= review.comment %></p>

      <% for(let i=0; i < review.rating; i++) { %>
        <span class="text-warning fs-5">⭐</span> 
      <% } %>

      <% if (currUser && review.reviewer._id.toString() === currUser._id.toString()) { %>

        <form class="mt-3" method="POST" action="/users/<%=user._id%>/review/<%= review._id %>?_method=DELETE">
        <button class="btn btn-danger btn-sm">Delete</button>
        </form>

     <% } %>

     </div>
    </div>

  <% } %>

<% } else { %>

  <p class="text-muted">No reviews available.</p>

<% } %>

</div>
</div>
</div>