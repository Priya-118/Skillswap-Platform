<% layout("/layouts/boilerplate") %>

<div class="container my-5">
  <div class="row align-items-center">
    
    <!-- Left Side Text -->
    <div class="col-md-6">
      <h2 class="mb-3">SkillSwap</h2>
      <p>
        SkillSwap is a peer-to-peer learning platform where users can exchange
        skills without monetary transactions. The platform allows people to
        offer their expertise while learning new skills from others in return.
      </p>
      <p>
        Users can create profiles, list the skills they can teach, and discover
        others who want to learn the same skills. The platform encourages
        collaborative learning and knowledge sharing within a community.
      </p>

       <!-- Button -->
      <a href="/users" class="btn btn-primary mt-3">
        View Users
      </a>
    </div>

    <!-- Right Side Image -->
    <div class="col-md-5 text-center">
      <img src="https://img.freepik.com/premium-vector/group-four-students-engages-collaborative-study-sharing-ideas-resources-wellorganized-table-people-are-studying-together-books_538213-147496.jpg" class="img-fluid rounded shadow" alt="SkillSwap">
    </div>

  </div>
</div>