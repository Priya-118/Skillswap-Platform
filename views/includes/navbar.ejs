      <button class="btn btn-search" type="submit">Search</button>
    </form>
        </div>

          <div class="navbar-nav ms-auto">
        <% if(!currUser)  { %>
          <a class="nav-link" href="/signup "><b>signup</b></a>
          <a class="nav-link" href="/login"><b>login</b></a>
          <% } %>
          
          <% if(currUser)  { %>
            <a class="nav-link" aria-disabled="true" href="/user/<%= currUser._id %>/detailuser"  alt="default"><b><%= currUser.username %></b></a>
            <a class="nav-link" aria-disabled="true" href="/notification"><b>notification</b></a>
          <a class="nav-link" aria-disabled="true" href="/logout"><b>logout</b></a>
          <% } %>
