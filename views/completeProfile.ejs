<% layout("/layouts/boilerplate.ejs") %>

<div class="form-container">
  <div class="form-card">
    <h2 class="form-title">Complete Your Profile</h2>

    <form action="/users/<%= id %>/completeprofile"  method="POST" enctype="multipart/form-data">

      <div class="form-group">
        <label>Profile Photo</label>
        <input type="file" name="profilePhoto">
      </div>

      <div class="form-group">
        <label>Location</label>
        <input type="text" name="location" required>
      </div>

      <div class="form-group">
        <label>Skills Offered</label>
        <input type="text" name="skillsOffered"
               placeholder="e.g. Python, Django, React" required>
      </div>

      <div class="form-group">
        <label>Skills Wanted</label>
        <input type="text" name="skillsWanted"
               placeholder="e.g. Web Design, GitHub" required>
      </div>

      <div class="form-group">
        <label>Availability</label>
        <select name="availability" required>
          <option value="Weekdays">Weekdays</option>
          <option value="Weekends">Weekends</option>
          <option value="Evenings">Evenings</option>
        </select>
      </div>

      <button  type="submit" class="btn-submit">
        Save Profile
      </button>

    </form>
  </div>
</div>