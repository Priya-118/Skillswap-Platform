<% layout("/layouts/boilerplate.ejs") %>

<form action="/completeprofile" method="POST">
   <div>
    <label for="profilePhoto">Profile Photo:</label>
    <!-- Or, if uploading a file: -->
    <input type="file" id="profilePhoto" name="profilePhoto">
  
  </div>

  <input type="text" name="location" placeholder="Location" required>

  <input type="text" name="skillsOffered" 
         placeholder="Skills Offered (comma separated)" required>

  <input type="text" name="skillsWanted" 
         placeholder="Skills Wanted (comma separated)" required>

  <select name="availability" required>
    <option value="Weekdays">Weekdays</option>
    <option value="Weekends">Weekends</option>
    <option value="Evenings">Evenings</option>
  </select>

  <button type="submit">Save Profile</button>

</form>