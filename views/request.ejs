<div id="request" class="card shadow-sm p-4 mt-4 col-8 offset-2">

  <h5 class="mb-3">Send Skill Swap Request</h5>

  <form action="/users/<%= user._id %>/request" method="POST">

    <div class="mb-3">
      <textarea 
        name="message" 
        class="form-control"
        rows="4"
        placeholder="Add your message..."
        required>
      </textarea>
    </div>

    <button type="submit" class="btn btn-primary">
      Send Request
    </button>

  </form>

</div>
</div>